---
import { ruta } from '../lib/formato';
import { presentacion, tienda } from '../config';

const enlaces = [
  { texto: 'Catálogo', href: ruta('catalogo') },
  { texto: presentacion.etiquetas.mujer, href: ruta('catalogo?linea=mujer') },
  { texto: presentacion.etiquetas.hombre, href: ruta('catalogo?linea=hombre') },
  { texto: 'Encuentra tu perfume', href: ruta('quiz') },
  { texto: 'Envíos', href: ruta('envios') },
];
---
<header class="sticky top-0 z-40 border-b border-borde/70 vidrio">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <a href={ruta('/')} class="flex shrink-0 items-baseline gap-2">
      <span class="titulo-serif text-2xl text-crema">Elisa</span>
      <span class="versalita text-champan">Perfumes</span>
    </a>

    <nav class="ml-auto hidden items-center gap-6 lg:flex" aria-label="Navegación principal">
      {enlaces.map((e) => (
        <a href={e.href} class="text-sm text-apagado transition-colors hover:text-champan">{e.texto}</a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <a
        href={`https://wa.me/${tienda.whatsapp}?text=${encodeURIComponent(tienda.whatsappSaludo)}`}
        target="_blank" rel="noopener"
        class="hidden rounded-full border border-borde px-3 py-2 text-xs text-apagado transition hover:border-oro/50 hover:text-champan sm:block"
      >WhatsApp</a>

      <button
        type="button"
        data-abrir-carrito
        class="relative rounded-full border border-oro/45 px-4 py-2 text-sm font-medium text-champan transition hover:bg-oro hover:text-noche"
        aria-label="Abrir carrito"
      >
        Carrito
        <span
          data-contador-carrito
          class="absolute -right-1.5 -top-1.5 hidden min-w-5 rounded-full bg-oro px-1.5 text-center text-[11px] font-bold leading-5 text-noche"
        >0</span>
      </button>

      <button
        type="button"
        data-abrir-menu
        class="rounded-full border border-borde p-2 text-crema lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </div>

  <nav data-menu-movil class="hidden border-t border-borde bg-carbon px-4 py-3 lg:hidden" aria-label="Navegación móvil">
    <ul class="space-y-1">
      {enlaces.map((e) => (
        <li>
          <a href={e.href} class="block rounded-lg px-3 py-2.5 text-sm text-crema/90 transition hover:bg-humo hover:text-champan">{e.texto}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const boton = document.querySelector('[data-abrir-menu]');
  const menu = document.querySelector('[data-menu-movil]');
  boton?.addEventListener('click', () => {
    const abierto = menu?.classList.toggle('hidden') === false;
    boton.setAttribute('aria-expanded', String(abierto));
  });
</script>
