---
import type { Producto } from '../lib/tipos';
import { nombre } from '../lib/catalogo';
import { ruta } from '../lib/formato';

/**
 * Foto del producto.
 *
 * Todas las fragancias vienen en el mismo frasco: uno por línea. Por eso la
 * foto se elige por `linea`, y sólo se usa una imagen propia cuando el producto
 * trae `img` (por ejemplo, si más adelante se fotografía uno por separado).
 * Como las fotos son idénticas, el número va superpuesto: es lo que distingue
 * una ficha de otra al recorrer el catálogo.
 */
type Props = { producto: Producto; class?: string; grande?: boolean; conNumero?: boolean };
const { producto: p, class: clase = '', grande = false, conNumero = false } = Astro.props;

const archivo = p.img ?? `img/productos/${p.linea}.webp`;
const etiqueta = nombre(p);
const alt = `${etiqueta}, frasco de 30 ml con su estuche`;
---
<div class={`relative h-full w-full ${clase}`}>
  <img
    src={ruta(archivo)}
    alt={alt}
    width={grande ? 800 : 400}
    height={grande ? 800 : 400}
    loading={grande ? 'eager' : 'lazy'}
    decoding="async"
    class="h-full w-full object-cover"
  />
  {conNumero && (
    <span class="absolute left-2.5 top-2.5 rounded-lg bg-fondo/75 px-2.5 py-1 font-[family-name:var(--font-display)] text-xl leading-none text-acento backdrop-blur-sm">
      {etiqueta}
    </span>
  )}
</div>
