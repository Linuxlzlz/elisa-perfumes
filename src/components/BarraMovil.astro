---
import { ruta } from '../lib/formato';
import { tienda } from '../config';
---
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-borde vidrio md:hidden">
  <div class="grid grid-cols-3 gap-1 p-2">
    <a href={ruta('catalogo')} class="flex flex-col items-center gap-1 rounded-lg py-2 text-[11px] text-tenue transition hover:text-acento">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h10" />
      </svg>
      Catálogo
    </a>

    <button type="button" data-abrir-carrito class="relative flex flex-col items-center gap-1 rounded-lg py-2 text-[11px] text-acento">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M6 7h12l-1 12H7L6 7Z" /><path d="M9 7a3 3 0 0 1 6 0" />
      </svg>
      Mi carrito
      <span data-contador-carrito class="absolute right-3 top-1 hidden min-w-4 rounded-full bg-acento px-1 text-center text-[10px] font-bold leading-4 text-fondo">0</span>
    </button>

    <a
      href={`https://wa.me/${tienda.whatsapp}?text=${encodeURIComponent(tienda.whatsappSaludo)}`}
      target="_blank" rel="noopener"
      class="flex flex-col items-center gap-1 rounded-lg py-2 text-[11px] text-tenue transition hover:text-acento"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5 0-1.8-.2-3.6-1.3-2-1.2-3.3-3.3-3.4-3.5-.1-.2-.8-1.3-.8-2.4s.6-1.7.8-1.9c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.7 1.7c.1.2.1.4 0 .6l-.4.5c-.1.2-.3.3-.1.6.1.3.6 1.1 1.3 1.7.9.8 1.6 1 1.9 1.2.2.1.4 0 .5-.1l.7-.8c.2-.2.4-.1.6 0l1.6.8c.2.1.4.2.4.4 0 .2 0 .8-.2 1.2Z" />
      </svg>
      WhatsApp
    </a>
  </div>
</div>
