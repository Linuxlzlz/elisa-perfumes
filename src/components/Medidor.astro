---
type Props = { etiqueta: string; valor: number; max?: number };
const { etiqueta, valor, max = 5 } = Astro.props;
---
<div class="flex items-center gap-3">
  <span class="w-20 shrink-0 text-xs text-apagado">{etiqueta}</span>
  <div class="flex gap-1" role="img" aria-label={`${etiqueta}: ${valor} de ${max}`}>
    {Array.from({ length: max }).map((_, i) => (
      <span
        class:list={[
          'h-1.5 w-6 rounded-full transition-colors',
          i < valor ? 'bg-oro' : 'bg-borde',
        ]}
      />
    ))}
  </div>
</div>
