---
import type { Producto } from '../lib/tipos';
import { clp, ruta } from '../lib/formato';
import { inspiradoEn, nombre } from '../lib/catalogo';
import FotoProducto from './FotoProducto.astro';

type Props = { producto: Producto };
const { producto: p } = Astro.props;

const titulo = nombre(p);
const referencia = inspiradoEn(p);
const enlace = ruta(`perfume/${p.slug}`);
---
<article
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-borde bg-superficie transition-all duration-300 hover:border-oro/45 hover:shadow-[0_18px_50px_-20px_rgba(201,162,39,0.35)]"
  data-slug={p.slug}
  data-skus={p.variantes.map((x) => x.sku).join(',')}
>
  <a href={enlace} class="relative block aspect-square overflow-hidden bg-fondo">
    <div class="h-full w-full transition-transform duration-500 ease-out group-hover:scale-[1.06]">
      <FotoProducto producto={p} conNumero />
    </div>

    {p.destacado && (
      <span class="absolute right-3 top-3 rounded-full bg-oro px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-fondo">
        Más pedido
      </span>
    )}

    <span
      class="absolute inset-x-0 bottom-0 hidden items-center justify-center bg-fondo/85 py-2 text-xs text-acento backdrop-blur data-[visible=true]:flex"
      data-agotado-cartel={p.slug}
    >Sin stock por ahora</span>
  </a>

  <div class="flex flex-1 flex-col gap-2.5 p-4">
    <div>
      <h3 class="titulo-serif text-2xl leading-none text-texto">
        <a href={enlace} class="hover:text-acento">{titulo}</a>
      </h3>
      {referencia && (
        <p class="mt-1.5 text-xs leading-snug text-acento/90">{referencia}</p>
      )}
      <p class="mt-1 text-[11px] text-tenue">{p.familia}</p>
    </div>

    <ul class="flex flex-wrap gap-1.5">
      {p.acordes.slice(0, 3).map((a) => (
        <li class="rounded border border-borde px-2 py-0.5 text-[11px] text-tenue">{a}</li>
      ))}
    </ul>

    <div class="mt-auto grid gap-2 pt-2" style={`grid-template-columns: repeat(${p.variantes.length}, minmax(0, 1fr))`}>
      {p.variantes.map((v) => (
        <button
          type="button"
          class="flex items-center justify-center gap-2 rounded-lg border border-acento/30 bg-acento/5 px-3 py-2.5 text-center transition hover:border-acento hover:bg-acento hover:text-fondo disabled:cursor-not-allowed disabled:opacity-45"
          data-agregar
          data-sku={v.sku}
          data-slug={p.slug}
          data-nombre={titulo}
          data-casa={referencia || p.familia}
          data-tamano={v.tamano}
          data-precio={v.precio}
        >
          <span class="text-sm font-semibold">{clp(v.precio)}</span>
          <span class="text-[11px] opacity-70">{v.tamano}</span>
        </button>
      ))}
    </div>
  </div>
</article>
