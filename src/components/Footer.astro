---
import { ruta } from '../lib/formato';
import { envios, pagos, presentacion, tienda } from '../config';
import Marca from './Marca.astro';
const anio = new Date().getFullYear();
---
<footer class="mt-24 border-t border-borde bg-carbon">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4 lg:px-8">
    <div class="md:col-span-1">
      <Marca tamano={52} variante="sello" id="pie" />
      <p class="titulo-serif mt-4 text-2xl text-crema">Elisa <span class="text-champan">Perfumes</span></p>
      <p class="mt-3 text-sm leading-relaxed text-apagado">{tienda.claim}</p>
      <p class="mt-4 text-sm text-apagado">{tienda.ciudad}</p>
      <p class="text-sm text-apagado">{tienda.horario}</p>
    </div>

    <div>
      <h3 class="versalita text-champan">Catálogo</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={ruta('catalogo')} class="text-apagado hover:text-crema">Ver todo</a></li>
        <li><a href={ruta('catalogo?linea=mujer')} class="text-apagado hover:text-crema">{presentacion.etiquetas.mujer}</a></li>
        <li><a href={ruta('catalogo?linea=hombre')} class="text-apagado hover:text-crema">{presentacion.etiquetas.hombre}</a></li>
        <li><a href={ruta('quiz')} class="text-apagado hover:text-crema">Encuentra tu perfume</a></li>
      </ul>
    </div>

    <div>
      <h3 class="versalita text-champan">Compra</h3>
      <ul class="mt-4 space-y-2 text-sm text-apagado">
        <li><a href={ruta('envios')} class="hover:text-crema">Envíos y plazos</a></li>
        <li>{envios.plazo}</li>
        <li>Envío gratis sobre $60.000</li>
        <li class="pt-2 text-xs">{pagos.join(' · ')}</li>
      </ul>
    </div>

    <div>
      <h3 class="versalita text-champan">Contacto</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href={`https://wa.me/${tienda.whatsapp}`} target="_blank" rel="noopener" class="text-apagado hover:text-crema">
            WhatsApp +{tienda.whatsapp}
          </a>
        </li>
        <li>
          <a href={`https://instagram.com/${tienda.instagram}`} target="_blank" rel="noopener" class="text-apagado hover:text-crema">
            @{tienda.instagram}
          </a>
        </li>
        <li><a href={`mailto:${tienda.email}`} class="text-apagado hover:text-crema">{tienda.email}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-borde px-4 py-6 sm:px-6 lg:px-8">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 text-xs text-apagado md:flex-row md:items-center md:justify-between">
      <p>© {anio} {tienda.nombre}. Todos los derechos reservados.</p>
      <p>
        Todos nuestros perfumes son de elaboración propia e inspirados en fragancias de
        terceros. Las marcas citadas pertenecen a sus respectivos titulares y se mencionan
        únicamente como referencia olfativa; no existe vínculo ni respaldo de esas casas.
      </p>
    </div>
  </div>
</footer>
