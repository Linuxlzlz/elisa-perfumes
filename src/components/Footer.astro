---
import { ruta } from '../lib/formato';
import { envios, pagos, presentacion, tienda } from '../config';
import Marca from './Marca.astro';
const anio = new Date().getFullYear();
---
<footer class="mt-24 border-t border-borde bg-superficie">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4 lg:px-8">
    <div class="md:col-span-1">
      <Marca tamano={52} variante="sello" tono="tinta" id="pie" class="text-acento" />
      <p class="titulo-serif mt-4 text-2xl text-texto">Elisa <span class="text-acento">Perfumes</span></p>
      <p class="mt-3 text-sm leading-relaxed text-tenue">{tienda.claim}</p>
      <p class="mt-4 text-sm text-tenue">{tienda.ciudad}</p>
      <p class="text-sm text-tenue">{tienda.horario}</p>
    </div>

    <div>
      <h3 class="versalita text-acento">Catálogo</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={ruta('catalogo')} class="text-tenue hover:text-texto">Ver todo</a></li>
        <li><a href={ruta('catalogo?linea=mujer')} class="text-tenue hover:text-texto">{presentacion.etiquetas.mujer}</a></li>
        <li><a href={ruta('catalogo?linea=hombre')} class="text-tenue hover:text-texto">{presentacion.etiquetas.hombre}</a></li>
        <li><a href={ruta('quiz')} class="text-tenue hover:text-texto">Encuentra tu perfume</a></li>
      </ul>
    </div>

    <div>
      <h3 class="versalita text-acento">Compra</h3>
      <ul class="mt-4 space-y-2 text-sm text-tenue">
        <li><a href={ruta('envios')} class="hover:text-texto">Envíos y plazos</a></li>
        <li>{envios.plazo}</li>
        <li>{envios.retiroTexto}</li>
        <li class="pt-2 text-xs">{pagos.join(' · ')}</li>
      </ul>
    </div>

    <div>
      <h3 class="versalita text-acento">Contacto</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href={`https://wa.me/${tienda.whatsapp}`} target="_blank" rel="noopener" class="text-tenue hover:text-texto">
            WhatsApp +56 9 2694 7785
          </a>
        </li>
        <li>
          <a href={`https://www.instagram.com/${tienda.instagram}/`} target="_blank" rel="noopener" class="text-tenue hover:text-texto">
            Instagram @{tienda.instagram}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-borde px-4 py-6 sm:px-6 lg:px-8">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 text-xs text-tenue md:flex-row md:items-center md:justify-between">
      <p>© {anio} {tienda.nombre}. Todos los derechos reservados.</p>
      <p>
        Todos nuestros perfumes son de elaboración propia e inspirados en fragancias de
        terceros. Las marcas citadas pertenecen a sus respectivos titulares y se mencionan
        únicamente como referencia olfativa; no existe vínculo ni respaldo de esas casas.
      </p>
    </div>
  </div>
</footer>
