---
import Base from '../layouts/Base.astro';
import { clp, ruta } from '../lib/formato';
import { envios, pagos, tienda } from '../config';

const pasos = [
  { n: '01', t: 'Armas tu carrito', d: 'Agregas las fragancias que quieras desde el catálogo.' },
  { n: '02', t: 'Envías el pedido', d: 'Al presionar “Enviar por WhatsApp” se abre el chat con tu pedido ya escrito y su código.' },
  { n: '03', t: 'Confirmamos', d: 'Validamos stock y total final, y te enviamos los datos de pago.' },
  { n: '04', t: 'Despachamos', d: `Con el pago confirmado, ${envios.plazo.toLowerCase()}. Te pasamos el número de seguimiento por el mismo chat.` },
  { n: '05', t: 'Coordinamos la entrega', d: `${envios.entrega}. Si prefieres retirar, lo dejamos listo en ${envios.puntosRetiro.join(' o ')}.` },
];

const preguntas = [
  { p: '¿Cuánto demora en llegar?', r: `Despachamos desde ${envios.origen} dentro de 48 horas hábiles desde que se confirma el pago. El tiempo que tarda en llegar después depende del courier y de tu comuna, así que eso lo coordinamos contigo por WhatsApp y te pasamos el seguimiento.` },
  { p: '¿Son perfumes originales?', r: 'No, y no los vendemos como tales. Son de elaboración propia, inspirados en el perfil olfativo de fragancias conocidas. En cada ficha decimos exactamente en cuál se inspira cada número.' },
  { p: '¿Cuánto dura el perfume en la piel?', r: 'Más de 8 horas. Son concentración alta de esencia, no agua de colonia. La duración varía según tu tipo de piel: en piel hidratada rinde bastante más.' },
  { p: '¿Puedo pagar al retirar?', r: `Sí, si retiras en ${envios.puntosRetiro.join(' o ')} puedes pagar en efectivo al momento. Para despachos pedimos el pago antes, por transferencia o link, porque el courier se paga al momento de despachar.` },
  { p: '¿Hacen cambios o devoluciones?', r: 'Sí. Si el producto llega dañado o no corresponde a lo pedido, lo reponemos o devolvemos el dinero. Por tratarse de productos de uso personal, no aceptamos devoluciones de frascos ya abiertos salvo falla.' },
  { p: '¿Tienen algo que no esté en el catálogo?', r: 'Escríbenos por WhatsApp con el nombre de la fragancia y te confirmamos si podemos conseguirla, a qué precio y en cuánto tiempo.' },
  { p: '¿Emiten boleta?', r: 'Sí, emitimos boleta electrónica por cada venta. Si necesitas factura, indícalo al confirmar el pedido.' },
];
---
<Base
  titulo="Envíos, pagos y preguntas frecuentes"
  descripcion="Cómo comprar en Elisa Perfumes: pedidos por WhatsApp, retiro en Hualañé y Curicó, despacho a todo Chile dentro de 48 horas, formas de pago y devoluciones."
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <header>
      <h1 class="titulo-serif text-4xl text-texto sm:text-5xl">Envíos y pagos</h1>
      <p class="mt-3 text-sm leading-relaxed text-tenue">
        Todo lo que necesitas saber antes de hacer tu pedido.
      </p>
    </header>

    <!-- Cómo comprar -->
    <section class="mt-12">
      <h2 class="titulo-serif text-2xl text-texto">Cómo comprar</h2>
      <ol class="mt-6 grid gap-5 sm:grid-cols-2">
        {pasos.map((p) => (
          <li class="rounded-2xl border border-borde bg-superficie p-5">
            <span class="versalita text-oro">{p.n}</span>
            <h3 class="mt-2 text-base font-semibold text-texto">{p.t}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-tenue">{p.d}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Costos -->
    <section class="mt-12">
      <h2 class="titulo-serif text-2xl text-texto">Costos de envío</h2>
      <div class="mt-6 overflow-hidden rounded-2xl border border-borde">
        <table class="w-full text-sm">
          <thead class="bg-panel text-left">
            <tr>
              <th scope="col" class="px-4 py-3 font-medium text-acento">Modalidad</th>
              <th scope="col" class="px-4 py-3 font-medium text-acento">Costo</th>
              <th scope="col" class="px-4 py-3 font-medium text-acento">Lo despachamos en</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-borde bg-superficie">
            {envios.puntosRetiro.map((punto) => (
              <tr>
                <td class="px-4 py-3 text-texto">Retiro en {punto}</td>
                <td class="px-4 py-3 text-exito">Gratis</td>
                <td class="px-4 py-3 text-tenue">A coordinar por WhatsApp</td>
              </tr>
            ))}
            <tr>
              <td class="px-4 py-3 text-texto">Despacho a todo Chile</td>
              <td class="px-4 py-3 text-texto">{clp(envios.despachoNacional)}</td>
              <td class="px-4 py-3 text-tenue">48 horas hábiles</td>
            </tr>
            <tr class="bg-oro/5">
              <td class="px-4 py-3 text-texto">Compras sobre {clp(envios.umbralEnvioGratis)}</td>
              <td class="px-4 py-3 font-semibold text-exito">Envío gratis</td>
              <td class="px-4 py-3 text-tenue">48 horas hábiles</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="mt-4 rounded-xl border border-acento/25 bg-acento/5 px-4 py-3.5">
        <p class="text-sm leading-relaxed text-texto">
          <strong class="font-semibold">Las 48 horas son de despacho, no de entrega.</strong>{' '}
          Ese es el plazo en que tu pedido sale de nuestras manos hacia el courier.
          Cuánto tarda en llegar después lo define la empresa de transporte y tu comuna,
          así que lo coordinamos contigo por WhatsApp y te pasamos el seguimiento.
        </p>
        <p class="mt-2 text-xs text-tenue">
          Los pedidos salen desde {envios.origen} con {envios.couriers.join(' y ')}.
          {' '}{envios.retiroTexto}.
        </p>
      </div>
    </section>

    <!-- Pagos -->
    <section class="mt-12">
      <h2 class="titulo-serif text-2xl text-texto">Formas de pago</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-3">
        {pagos.map((p) => (
          <li class="rounded-xl border border-borde bg-superficie px-4 py-3.5 text-sm text-texto">{p}</li>
        ))}
      </ul>
    </section>

    <!-- FAQ -->
    <section class="mt-12">
      <h2 class="titulo-serif text-2xl text-texto">Preguntas frecuentes</h2>
      <div class="mt-6 divide-y divide-borde overflow-hidden rounded-2xl border border-borde bg-superficie">
        {preguntas.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-sm font-medium text-texto transition hover:bg-panel">
              {f.p}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-tenue transition-transform group-open:rotate-45" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="px-5 pb-5 text-sm leading-relaxed text-tenue">{f.r}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Contacto -->
    <section class="mt-12 rounded-3xl border border-oro/25 bg-gradient-to-br from-panel to-superficie p-8 text-center">
      <h2 class="titulo-serif text-2xl text-texto">¿Te quedó alguna duda?</h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-tenue">
        Escríbenos por WhatsApp. Respondemos {tienda.horario.toLowerCase()}.
      </p>
      <a
        href={`https://wa.me/${tienda.whatsapp}?text=${encodeURIComponent(tienda.whatsappSaludo)}`}
        target="_blank" rel="noopener"
        class="mt-6 inline-block rounded-full bg-[#25D366] px-7 py-3.5 text-sm font-bold text-[#07261a] transition hover:brightness-110"
      >Escribir por WhatsApp</a>
      <p class="mt-4 text-xs text-tenue">
        O mira el <a href={ruta('catalogo')} class="text-acento underline underline-offset-4">catálogo completo</a>.
      </p>
    </section>
  </div>
</Base>
