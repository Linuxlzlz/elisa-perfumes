---
import Base from '../layouts/Base.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import {
  casasReferencia, etiquetasLinea, familias, productos, todasLasOcasiones,
} from '../lib/catalogo';
import { presentacion } from '../config';

const ordenados = [...productos].sort((a, b) => a.numero - b.numero);
const lineas = Object.entries(etiquetasLinea).map(([clave, v]) => ({ clave, ...v }));
---
<Base
  titulo="Catálogo completo"
  descripcion={`Las ${productos.length} fragancias de Elisa Perfumes en 30 y 100 ml. Filtra por línea, familia olfativa, ocasión, intensidad y casa de referencia.`}
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <header>
      <h1 class="titulo-serif text-4xl text-texto sm:text-5xl">Catálogo</h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-tenue">
        {productos.length} fragancias, todas disponibles en 30 y 100 ml al mismo precio.
        Cada una se identifica por su número{presentacion.mostrarReferencia ? ' y te indicamos en qué se inspira' : ''}.
      </p>
    </header>

    <!-- ░░ Filtros ░░ -->
    <section class="mt-8 rounded-2xl border border-borde bg-superficie p-4 sm:p-5" aria-label="Filtros">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <div class="sm:col-span-2 lg:col-span-1">
          <label for="f-buscar" class="mb-1.5 block text-xs text-tenue">Buscar</label>
          <input
            id="f-buscar" type="search" placeholder="Número, marca, nota olfativa…"
            class="w-full rounded-lg border border-borde bg-panel px-3 py-2.5 text-sm text-texto placeholder:text-tenue/60 focus:border-oro focus:outline-none"
          />
        </div>

        <div>
          <label for="f-linea" class="mb-1.5 block text-xs text-tenue">Línea</label>
          <select id="f-linea" class="w-full rounded-lg border border-borde bg-panel px-3 py-2.5 text-sm text-texto focus:border-oro focus:outline-none">
            <option value="">Todas</option>
            {lineas.map((l) => <option value={l.clave}>{l.titulo}</option>)}
          </select>
        </div>

        <div>
          <label for="f-familia" class="mb-1.5 block text-xs text-tenue">Familia olfativa</label>
          <select id="f-familia" class="w-full rounded-lg border border-borde bg-panel px-3 py-2.5 text-sm text-texto focus:border-oro focus:outline-none">
            <option value="">Todas</option>
            {familias.map((f) => <option value={f}>{f}</option>)}
          </select>
        </div>

        <div>
          <label for="f-ocasion" class="mb-1.5 block text-xs text-tenue">Ocasión</label>
          <select id="f-ocasion" class="w-full rounded-lg border border-borde bg-panel px-3 py-2.5 text-sm text-texto focus:border-oro focus:outline-none">
            <option value="">Cualquiera</option>
            {todasLasOcasiones.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>

        <div>
          <label for="f-intensidad" class="mb-1.5 block text-xs text-tenue">Intensidad</label>
          <select id="f-intensidad" class="w-full rounded-lg border border-borde bg-panel px-3 py-2.5 text-sm text-texto focus:border-oro focus:outline-none">
            <option value="">Cualquiera</option>
            <option value="3">Discreta — para oficina</option>
            <option value="4">Equilibrada — se nota sin invadir</option>
            <option value="5">Alta — deja estela</option>
          </select>
        </div>

        {presentacion.mostrarReferencia && (
          <div>
            <label for="f-casa" class="mb-1.5 block text-xs text-tenue">Inspirado en una casa</label>
            <select id="f-casa" class="w-full rounded-lg border border-borde bg-panel px-3 py-2.5 text-sm text-texto focus:border-oro focus:outline-none">
              <option value="">Todas</option>
              {casasReferencia.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
        )}

        <div>
          <label for="f-orden" class="mb-1.5 block text-xs text-tenue">Ordenar por</label>
          <select id="f-orden" class="w-full rounded-lg border border-borde bg-panel px-3 py-2.5 text-sm text-texto focus:border-oro focus:outline-none">
            <option value="numero">Número de catálogo</option>
            <option value="relevancia">Más pedidos primero</option>
            <option value="referencia">Marca de referencia (A-Z)</option>
            <option value="intensidad">Mayor intensidad</option>
          </select>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-borde pt-4">
        <p class="text-sm text-tenue">
          <span data-conteo class="font-semibold text-texto">{productos.length}</span> fragancias
        </p>
        <button type="button" data-limpiar class="text-xs text-tenue underline-offset-4 transition hover:text-acento hover:underline">
          Limpiar filtros
        </button>
      </div>
    </section>

    <!-- ░░ Resultados ░░ -->
    <div data-grilla class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {ordenados.map((p) => (
        <div
          data-item
          data-numero={p.numero}
          data-linea={p.linea}
          data-familia={p.familia}
          data-casa={p.referencia.casa}
          data-ocasiones={p.ocasiones.join('|')}
          data-intensidad={p.proyeccion}
          data-referencia={p.referencia.nombre}
          data-destacado={p.destacado ? '1' : '0'}
          data-texto={[
            `n ${p.numero}`, `nº ${p.numero}`, `numero ${p.numero}`,
            presentacion.mostrarReferencia ? p.referencia.nombre : '',
            presentacion.mostrarReferencia ? p.referencia.casa : '',
            p.familia, ...p.acordes, ...p.ocasiones,
            ...p.notas.salida, ...p.notas.corazon, ...p.notas.fondo,
          ].join(' ').toLowerCase()}
        >
          <TarjetaProducto producto={p} />
        </div>
      ))}
    </div>

    <p data-sin-resultados class="hidden py-20 text-center text-sm text-tenue">
      No hay fragancias con esos filtros.<br />
      <button type="button" data-limpiar class="mt-3 text-acento underline underline-offset-4">Limpiar los filtros</button>
    </p>
  </div>

  <script>
    const grilla = document.querySelector<HTMLElement>('[data-grilla]')!;
    const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    const conteo = document.querySelector<HTMLElement>('[data-conteo]')!;
    const sinResultados = document.querySelector<HTMLElement>('[data-sin-resultados]')!;

    const campo = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const buscar = campo<HTMLInputElement>('f-buscar')!;
    const linea = campo<HTMLSelectElement>('f-linea')!;
    const familia = campo<HTMLSelectElement>('f-familia')!;
    const ocasion = campo<HTMLSelectElement>('f-ocasion')!;
    const intensidad = campo<HTMLSelectElement>('f-intensidad')!;
    const casa = campo<HTMLSelectElement>('f-casa');   // ausente si se oculta la referencia
    const orden = campo<HTMLSelectElement>('f-orden')!;

    const selects = [linea, familia, ocasion, intensidad, orden, ...(casa ? [casa] : [])];

    function aplicar() {
      const texto = buscar.value.trim().toLowerCase();
      const minIntensidad = Number(intensidad.value || 0);

      let visibles = 0;
      for (const it of items) {
        const d = it.dataset;
        const pasa =
          (!texto || (d.texto ?? '').includes(texto)) &&
          (!linea.value || d.linea === linea.value) &&
          (!familia.value || d.familia === familia.value) &&
          (!casa?.value || d.casa === casa.value) &&
          (!ocasion.value || (d.ocasiones ?? '').split('|').includes(ocasion.value)) &&
          (!minIntensidad || Number(d.intensidad) >= minIntensidad);

        it.hidden = !pasa;
        if (pasa) visibles++;
      }

      conteo.textContent = String(visibles);
      sinResultados.classList.toggle('hidden', visibles > 0);

      const comparar: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
        numero: (a, b) => Number(a.dataset.numero) - Number(b.dataset.numero),
        intensidad: (a, b) =>
          Number(b.dataset.intensidad) - Number(a.dataset.intensidad) ||
          Number(a.dataset.numero) - Number(b.dataset.numero),
        referencia: (a, b) =>
          (a.dataset.referencia ?? '').localeCompare(b.dataset.referencia ?? '', 'es'),
        relevancia: (a, b) =>
          Number(b.dataset.destacado) - Number(a.dataset.destacado) ||
          Number(a.dataset.numero) - Number(b.dataset.numero),
      };
      const fn = comparar[orden.value] ?? comparar.numero;
      for (const it of [...items].sort(fn)) grilla.appendChild(it);

      const url = new URL(location.href);
      if (linea.value) url.searchParams.set('linea', linea.value);
      else url.searchParams.delete('linea');
      history.replaceState(null, '', url);
    }

    buscar.addEventListener('input', aplicar);
    for (const s of selects) s.addEventListener('change', aplicar);

    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-limpiar]')) {
      b.addEventListener('click', () => {
        buscar.value = '';
        for (const s of [linea, familia, ocasion, intensidad, casa]) if (s) s.value = '';
        orden.value = 'numero';
        aplicar();
      });
    }

    const inicial = new URLSearchParams(location.search).get('linea');
    if (inicial && [...linea.options].some((o) => o.value === inicial)) linea.value = inicial;
    aplicar();
  </script>
</Base>
