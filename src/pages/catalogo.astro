---
import Base from '../layouts/Base.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import { casas, etiquetasCategoria, familias, productos, todasLasOcasiones, precioDesde } from '../lib/catalogo';
import { clp } from '../lib/formato';

const ordenados = [...productos].sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
const precioMaximo = Math.max(...productos.flatMap((p) => p.variantes.map((v) => v.precio)));
const topeRedondeado = Math.ceil(precioMaximo / 10000) * 10000;

const categorias = Object.entries(etiquetasCategoria).map(([clave, v]) => ({ clave, ...v }));
---
<Base
  titulo="Catálogo"
  descripcion="Catálogo completo de perfumes: originales sellados, decants, alternativas y nicho árabe. Filtra por familia olfativa, género, ocasión y precio."
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <header>
      <h1 class="titulo-serif text-4xl text-crema sm:text-5xl">Catálogo</h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-apagado">
        {productos.length} fragancias disponibles. Filtra por lo que te importa y escríbenos
        si no encuentras lo que buscas: conseguimos por encargo.
      </p>
    </header>

    <!-- ░░ Filtros ░░ -->
    <section class="mt-8 rounded-2xl border border-borde bg-carbon p-4 sm:p-5" aria-label="Filtros">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="sm:col-span-2 lg:col-span-1">
          <label for="f-buscar" class="mb-1.5 block text-xs text-apagado">Buscar</label>
          <input
            id="f-buscar" type="search" placeholder="Nombre, casa, nota…"
            class="w-full rounded-lg border border-borde bg-humo px-3 py-2.5 text-sm text-crema placeholder:text-apagado/60 focus:border-oro focus:outline-none"
          />
        </div>

        <div>
          <label for="f-categoria" class="mb-1.5 block text-xs text-apagado">Línea</label>
          <select id="f-categoria" class="w-full rounded-lg border border-borde bg-humo px-3 py-2.5 text-sm text-crema focus:border-oro focus:outline-none">
            <option value="">Todas</option>
            {categorias.map((c) => <option value={c.clave}>{c.titulo}</option>)}
          </select>
        </div>

        <div>
          <label for="f-genero" class="mb-1.5 block text-xs text-apagado">Género</label>
          <select id="f-genero" class="w-full rounded-lg border border-borde bg-humo px-3 py-2.5 text-sm text-crema focus:border-oro focus:outline-none">
            <option value="">Todos</option>
            <option value="femenino">Femenino</option>
            <option value="masculino">Masculino</option>
            <option value="unisex">Unisex</option>
          </select>
        </div>

        <div>
          <label for="f-familia" class="mb-1.5 block text-xs text-apagado">Familia olfativa</label>
          <select id="f-familia" class="w-full rounded-lg border border-borde bg-humo px-3 py-2.5 text-sm text-crema focus:border-oro focus:outline-none">
            <option value="">Todas</option>
            {familias.map((f) => <option value={f}>{f}</option>)}
          </select>
        </div>

        <div>
          <label for="f-ocasion" class="mb-1.5 block text-xs text-apagado">Ocasión</label>
          <select id="f-ocasion" class="w-full rounded-lg border border-borde bg-humo px-3 py-2.5 text-sm text-crema focus:border-oro focus:outline-none">
            <option value="">Cualquiera</option>
            {todasLasOcasiones.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>

        <div>
          <label for="f-casa" class="mb-1.5 block text-xs text-apagado">Casa</label>
          <select id="f-casa" class="w-full rounded-lg border border-borde bg-humo px-3 py-2.5 text-sm text-crema focus:border-oro focus:outline-none">
            <option value="">Todas</option>
            {casas.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>

        <div>
          <label for="f-precio" class="mb-1.5 block text-xs text-apagado">
            Hasta <span data-precio-etiqueta class="text-champan">{clp(topeRedondeado)}</span>
          </label>
          <input
            id="f-precio" type="range" min="10000" max={topeRedondeado} step="5000" value={topeRedondeado}
            class="mt-3 w-full accent-oro"
          />
        </div>

        <div>
          <label for="f-orden" class="mb-1.5 block text-xs text-apagado">Ordenar por</label>
          <select id="f-orden" class="w-full rounded-lg border border-borde bg-humo px-3 py-2.5 text-sm text-crema focus:border-oro focus:outline-none">
            <option value="relevancia">Recomendados</option>
            <option value="precio-asc">Precio: menor a mayor</option>
            <option value="precio-desc">Precio: mayor a menor</option>
            <option value="nombre">Nombre (A-Z)</option>
          </select>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-borde pt-4">
        <p class="text-sm text-apagado">
          <span data-conteo class="font-semibold text-crema">{productos.length}</span> resultados
        </p>
        <button type="button" data-limpiar class="text-xs text-apagado underline-offset-4 transition hover:text-champan hover:underline">
          Limpiar filtros
        </button>
      </div>
    </section>

    <!-- ░░ Resultados ░░ -->
    <div data-grilla class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {ordenados.map((p) => (
        <div
          data-item
          data-categoria={p.categoria}
          data-genero={p.genero}
          data-familia={p.familia}
          data-casa={p.casa}
          data-ocasiones={p.ocasiones.join('|')}
          data-precio={precioDesde(p)}
          data-nombre={p.nombre}
          data-destacado={p.destacado ? '1' : '0'}
          data-texto={[
            p.nombre, p.casa, p.familia, p.concentracion, p.perfilSimilarA ?? '',
            ...p.acordes, ...p.notas.salida, ...p.notas.corazon, ...p.notas.fondo,
          ].join(' ').toLowerCase()}
        >
          <TarjetaProducto producto={p} />
        </div>
      ))}
    </div>

    <p data-sin-resultados class="hidden py-20 text-center text-sm text-apagado">
      No hay fragancias con esos filtros.<br />
      <button type="button" data-limpiar class="mt-3 text-champan underline underline-offset-4">Limpiar los filtros</button>
    </p>
  </div>

  <script>
    import { clp } from '../lib/formato';

    const grilla = document.querySelector<HTMLElement>('[data-grilla]')!;
    const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    const conteo = document.querySelector<HTMLElement>('[data-conteo]')!;
    const sinResultados = document.querySelector<HTMLElement>('[data-sin-resultados]')!;
    const etiquetaPrecio = document.querySelector<HTMLElement>('[data-precio-etiqueta]')!;

    const campo = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const buscar = campo<HTMLInputElement>('f-buscar');
    const categoria = campo<HTMLSelectElement>('f-categoria');
    const genero = campo<HTMLSelectElement>('f-genero');
    const familia = campo<HTMLSelectElement>('f-familia');
    const ocasion = campo<HTMLSelectElement>('f-ocasion');
    const casa = campo<HTMLSelectElement>('f-casa');
    const precio = campo<HTMLInputElement>('f-precio');
    const orden = campo<HTMLSelectElement>('f-orden');

    const controles = [buscar, categoria, genero, familia, ocasion, casa, precio, orden];

    function aplicar() {
      const texto = buscar.value.trim().toLowerCase();
      const tope = Number(precio.value);
      etiquetaPrecio.textContent = clp(tope);

      let visibles = 0;
      for (const it of items) {
        const d = it.dataset;
        const pasa =
          (!texto || (d.texto ?? '').includes(texto)) &&
          (!categoria.value || d.categoria === categoria.value) &&
          (!genero.value || d.genero === genero.value) &&
          (!familia.value || d.familia === familia.value) &&
          (!casa.value || d.casa === casa.value) &&
          (!ocasion.value || (d.ocasiones ?? '').split('|').includes(ocasion.value)) &&
          Number(d.precio) <= tope;

        it.hidden = !pasa;
        if (pasa) visibles++;
      }

      conteo.textContent = String(visibles);
      sinResultados.classList.toggle('hidden', visibles > 0);

      // Reordenar solo los visibles
      const comparar: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
        'precio-asc': (a, b) => Number(a.dataset.precio) - Number(b.dataset.precio),
        'precio-desc': (a, b) => Number(b.dataset.precio) - Number(a.dataset.precio),
        nombre: (a, b) => (a.dataset.nombre ?? '').localeCompare(b.dataset.nombre ?? '', 'es'),
        relevancia: (a, b) =>
          Number(b.dataset.destacado) - Number(a.dataset.destacado) ||
          (a.dataset.nombre ?? '').localeCompare(b.dataset.nombre ?? '', 'es'),
      };
      const fn = comparar[orden.value] ?? comparar.relevancia;
      for (const it of [...items].sort(fn)) grilla.appendChild(it);

      // Reflejar la línea elegida en la URL, sin recargar
      const url = new URL(location.href);
      if (categoria.value) url.searchParams.set('categoria', categoria.value);
      else url.searchParams.delete('categoria');
      history.replaceState(null, '', url);
    }

    for (const c of controles) {
      c.addEventListener('input', aplicar);
      c.addEventListener('change', aplicar);
    }

    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-limpiar]')) {
      b.addEventListener('click', () => {
        buscar.value = '';
        for (const s of [categoria, genero, familia, ocasion, casa]) s.value = '';
        precio.value = precio.max;
        orden.value = 'relevancia';
        aplicar();
      });
    }

    // Preselección desde la URL: /catalogo?categoria=decants
    const inicial = new URLSearchParams(location.search).get('categoria');
    if (inicial && [...categoria.options].some((o) => o.value === inicial)) {
      categoria.value = inicial;
    }
    aplicar();
  </script>
</Base>
