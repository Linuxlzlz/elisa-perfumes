---
import Base from '../../layouts/Base.astro';
import FotoProducto from '../../components/FotoProducto.astro';
import PiramideOlfativa from '../../components/PiramideOlfativa.astro';
import Medidor from '../../components/Medidor.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import {
  etiquetasLinea, inspiradoEn, nombre, productos, relacionados, tituloLargo,
} from '../../lib/catalogo';
import { clp, ruta } from '../../lib/formato';
import { envios, presentacion, tienda } from '../../config';

export function getStaticPaths() {
  return productos.map((p) => ({ params: { slug: p.slug }, props: { producto: p } }));
}

const { producto: p } = Astro.props;
const similares = relacionados(p, 4);
const chica = p.variantes.reduce((a, b) => (a.precio <= b.precio ? a : b));
const titulo = nombre(p);
const referencia = inspiradoEn(p);

const urlCanonica = new URL(ruta(`perfume/${p.slug}`), Astro.site ?? 'https://example.com').href;

// La marca del producto es la tienda: la casa de referencia NO es el fabricante.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: tituloLargo(p),
  brand: { '@type': 'Brand', name: tienda.nombre },
  category: `Perfume ${etiquetasLinea[p.linea].titulo}`,
  description: `${p.descripcion}${referencia ? ` ${referencia}.` : ''}`,
  url: urlCanonica,
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Familia olfativa', value: p.familia },
    { '@type': 'PropertyValue', name: 'Proyección', value: `${p.proyeccion} de 5` },
    { '@type': 'PropertyValue', name: 'Duración', value: `${p.duracion} de 5` },
  ],
  offers: p.variantes.map((v) => ({
    '@type': 'Offer',
    name: `${titulo} ${v.tamano}`,
    sku: v.sku,
    price: v.precio,
    priceCurrency: 'CLP',
    availability: 'https://schema.org/InStock',
    url: urlCanonica,
    seller: { '@type': 'Organization', name: tienda.nombre },
  })),
});

const consultaWsp = encodeURIComponent(
  `Hola 👋 quiero consultar por el ${titulo}${referencia ? ` (${referencia})` : ''}.`,
);
---
<Base
  titulo={tituloLargo(p)}
  descripcion={`${titulo}: ${p.familia.toLowerCase()}. ${p.descripcion.slice(0, 115)}`}
  datosEstructurados={jsonLd}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <nav aria-label="Ruta de navegación" class="text-xs text-tenue">
      <a href={ruta('/')} class="hover:text-acento">Inicio</a>
      <span class="mx-1.5">/</span>
      <a href={ruta(`catalogo?linea=${p.linea}`)} class="hover:text-acento">
        {etiquetasLinea[p.linea].titulo}
      </a>
      <span class="mx-1.5">/</span>
      <span class="text-texto/80">{titulo}</span>
    </nav>

    <div class="mt-6 grid gap-10 lg:grid-cols-2">
      <!-- ░░ Imagen ░░ -->
      <div class="relative">
        <div class="pointer-events-none absolute inset-0 rounded-3xl bg-oro/10 blur-3xl"></div>
        <div class="relative aspect-square overflow-hidden rounded-3xl border border-borde bg-superficie">
          <FotoProducto producto={p} grande />
        </div>
      </div>

      <!-- ░░ Información y compra ░░ -->
      <div>
        <p class="versalita text-acento">{etiquetasLinea[p.linea].titulo}</p>
        <h1 class="titulo-serif mt-2 text-5xl leading-none text-texto sm:text-6xl">{titulo}</h1>

        {referencia && (
          <p class="mt-3 text-lg text-acento">{referencia}</p>
        )}

        <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
          <span class="rounded-full border border-borde px-2.5 py-1 text-tenue">{p.familia}</span>
          {p.acordes.map((a) => (
            <span class="rounded-full border border-borde px-2.5 py-1 text-tenue">{a}</span>
          ))}
        </div>

        <p class="mt-5 text-base leading-relaxed text-texto/90">{p.descripcion}</p>

        {referencia && (
          <p class="mt-4 rounded-lg border border-borde bg-panel px-4 py-3 text-xs leading-relaxed text-tenue">
            Perfume de elaboración propia, inspirado en el perfil olfativo de
            <span class="text-texto"> {p.referencia.nombre}</span> de {p.referencia.casa}.
            No es ese producto ni guarda relación con esa casa; la marca se cita solo como
            referencia de aroma.
          </p>
        )}

        <!-- Selector de tamaño: sólo aparece si hay más de un formato -->
        <div class="mt-7" style={p.variantes.length < 2 ? 'display:none' : undefined}>
          <p class="versalita mb-2.5 text-tenue">Elige el tamaño</p>
          <div class="grid grid-cols-2 gap-3" role="radiogroup" aria-label="Tamaño">
            {p.variantes.map((v, i) => (
              <button
                type="button"
                data-variante
                data-sku={v.sku}
                data-tamano={v.tamano}
                data-precio={v.precio}
                aria-checked={i === 0 ? 'true' : 'false'}
                role="radio"
                class:list={[
                  'rounded-xl border px-4 py-3.5 text-left transition',
                  i === 0 ? 'border-oro bg-oro/10' : 'border-borde bg-panel hover:border-oro/40',
                ]}
              >
                <span class="block text-base font-semibold text-texto">{v.tamano}</span>
                <span class="block text-sm text-acento">{clp(v.precio)}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Precio y acciones -->
        <div class="mt-6 rounded-2xl border border-borde bg-superficie p-5">
          <div class="flex items-end justify-between gap-4">
            <div>
              <span class="block text-xs text-tenue">Precio</span>
              <span data-precio-activo class="text-3xl font-semibold text-texto">{clp(chica.precio)}</span>
              <span data-tamano-activo class="ml-1 text-sm text-tenue">/ {chica.tamano}</span>
            </div>
            <span data-estado-stock class="rounded-full border border-exito/40 px-3 py-1 text-xs text-exito">
              Disponible
            </span>
          </div>

          <button
            type="button"
            data-agregar
            data-sku={chica.sku}
            data-slug={p.slug}
            data-nombre={titulo}
            data-casa={referencia || p.familia}
            data-tamano={chica.tamano}
            data-precio={chica.precio}
            class="mt-5 w-full rounded-full bg-acento px-6 py-3.5 text-sm font-bold text-fondo transition hover:bg-[#9c2b45] disabled:cursor-not-allowed disabled:bg-borde disabled:text-tenue"
          >Agregar al carrito</button>

          <div class="mt-2 flex gap-2">
            <button type="button" data-abrir-carrito class="flex-1 rounded-full border border-borde px-4 py-2.5 text-xs text-tenue transition hover:border-oro/50 hover:text-acento">
              Ver mi pedido
            </button>
            <a
              href={`https://wa.me/${tienda.whatsapp}?text=${consultaWsp}`}
              target="_blank" rel="noopener"
              class="flex-1 rounded-full border border-borde px-4 py-2.5 text-center text-xs text-tenue transition hover:border-oro/50 hover:text-acento"
            >Consultar por WhatsApp</a>
          </div>

          <p class="mt-4 border-t border-borde pt-3 text-[11px] leading-relaxed text-tenue">
            {envios.plazo}. {envios.entrega}. Envío gratis sobre {clp(envios.umbralEnvioGratis)}.
          </p>
        </div>

        <!-- Rendimiento -->
        <div class="mt-7 space-y-2.5">
          <Medidor etiqueta="Proyección" valor={p.proyeccion} />
          <Medidor etiqueta="Duración" valor={p.duracion} />
        </div>

        <dl class="mt-7 grid grid-cols-2 gap-4 border-t border-borde pt-5 text-sm">
          <div>
            <dt class="text-xs text-tenue">Mejor en</dt>
            <dd class="mt-1 text-texto/90">{p.ocasiones.join(', ')}</dd>
          </div>
          <div>
            <dt class="text-xs text-tenue">Estaciones</dt>
            <dd class="mt-1 text-texto/90">{p.estaciones.join(', ')}</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- ░░ Pirámide olfativa ░░ -->
    <section class="mt-16 rounded-3xl border border-borde bg-superficie p-6 sm:p-10">
      <h2 class="titulo-serif text-3xl text-texto">Pirámide olfativa</h2>
      <p class="mt-2 max-w-2xl text-sm text-tenue">
        Cómo evoluciona la fragancia desde la primera pulsación hasta las últimas horas.
      </p>
      <div class="mt-8 grid gap-10 lg:grid-cols-[1.4fr_1fr]">
        <PiramideOlfativa notas={p.notas} />
        <div class="rounded-2xl border border-borde bg-panel p-5">
          <h3 class="versalita text-acento">Acordes dominantes</h3>
          <ul class="mt-3 space-y-2">
            {p.acordes.map((a) => (
              <li class="flex items-center gap-2.5 text-sm text-texto/90">
                <span class="h-1.5 w-1.5 rounded-full bg-oro"></span>{a}
              </li>
            ))}
          </ul>
          <p class="mt-5 border-t border-borde pt-4 text-xs leading-relaxed text-tenue">
            Consejo: aplica sobre la piel hidratada en muñecas y cuello. No frotes,
            porque rompe las moléculas y acorta la duración.
          </p>
        </div>
      </div>
    </section>

    <!-- ░░ Relacionados ░░ -->
    {similares.length > 0 && (
      <section class="mt-16">
        <h2 class="titulo-serif text-3xl text-texto">También te puede gustar</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {similares.map((s) => <TarjetaProducto producto={s} />)}
        </div>
      </section>
    )}
  </div>

  <script>
    import { clp } from '../../lib/formato';
    import { cargarStock, estadoDe, etiquetasEstado, precioDe } from '../../lib/stock';

    const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-variante]')];
    const agregar = document.querySelector<HTMLButtonElement>('[data-agregar]')!;
    const elPrecio = document.querySelector<HTMLElement>('[data-precio-activo]')!;
    const elTamano = document.querySelector<HTMLElement>('[data-tamano-activo]')!;
    const elEstado = document.querySelector<HTMLElement>('[data-estado-stock]')!;

    let stock: Awaited<ReturnType<typeof cargarStock>> = {};

    function seleccionar(b: HTMLButtonElement) {
      for (const otro of botones) {
        const activo = otro === b;
        otro.setAttribute('aria-checked', String(activo));
        otro.classList.toggle('border-oro', activo);
        otro.classList.toggle('bg-oro/10', activo);
        otro.classList.toggle('border-borde', !activo);
        otro.classList.toggle('bg-panel', !activo);
      }

      const sku = b.dataset.sku!;
      const precio = precioDe(stock, sku, Number(b.dataset.precio));
      const estado = estadoDe(stock, sku);

      elPrecio.textContent = clp(precio);
      elTamano.textContent = `/ ${b.dataset.tamano}`;

      agregar.dataset.sku = sku;
      agregar.dataset.tamano = b.dataset.tamano!;
      agregar.dataset.precio = String(precio);

      const agotado = estado === 'agotado';
      agregar.disabled = agotado;
      agregar.textContent = agotado ? 'Agotado' : estado === 'encargo' ? 'Pedir por encargo' : 'Agregar al carrito';

      elEstado.textContent = etiquetasEstado[estado];
      elEstado.className =
        'rounded-full border px-3 py-1 text-xs ' +
        (estado === 'disponible'
          ? 'border-exito/40 text-exito'
          : estado === 'encargo'
            ? 'border-oro/40 text-acento'
            : 'border-alerta/40 text-alerta');
    }

    for (const b of botones) b.addEventListener('click', () => seleccionar(b));

    cargarStock().then((mapa) => {
      stock = mapa;
      for (const b of botones) {
        const sku = b.dataset.sku!;
        const precio = precioDe(mapa, sku, Number(b.dataset.precio));
        b.dataset.precio = String(precio);
        const etiqueta = b.querySelector('span:last-child');
        if (etiqueta) {
          etiqueta.textContent = estadoDe(mapa, sku) === 'agotado' ? 'Agotado' : clp(precio);
        }
      }
      const primero = botones.find((b) => estadoDe(mapa, b.dataset.sku!) !== 'agotado') ?? botones[0];
      if (primero) seleccionar(primero);
    });
  </script>
</Base>
