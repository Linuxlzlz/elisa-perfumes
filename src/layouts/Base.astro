---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CarritoDrawer from '../components/CarritoDrawer.astro';
import BarraMovil from '../components/BarraMovil.astro';
import { tienda } from '../config';
import { ruta } from '../lib/formato';

type Props = {
  titulo?: string;
  descripcion?: string;
  /** JSON-LD ya serializado, para las fichas de producto. */
  datosEstructurados?: string;
  sinIndexar?: boolean;
};

const {
  titulo,
  descripcion = tienda.descripcion,
  datosEstructurados,
  sinIndexar = false,
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} | ${tienda.nombre}` : `${tienda.nombre}. ${tienda.claim}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
// Imagen que se ve al pegar el enlace en WhatsApp, Instagram o Facebook.
const imagenSocial = new URL(ruta('og.png'), Astro.site ?? 'https://example.com').href;
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {sinIndexar && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={tienda.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${tienda.nombre}. ${tienda.claim}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagenSocial} />
    <meta name="theme-color" content="#0b0a09" />

    <link rel="icon" href={ruta('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={ruta('sitemap-index.xml')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Inter:wght@400;500;600;700&display=swap"
    />

    {datosEstructurados && <script type="application/ld+json" set:html={datosEstructurados} />}
  </head>

  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-lg focus:bg-acento focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-fondo"
    >Saltar al contenido</a>

    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <BarraMovil />
    <CarritoDrawer />

    <script>
      // Animación de entrada por scroll
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              observador.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('.aparece').forEach((el) => observador.observe(el));
    </script>
  </body>
</html>
